# Local dev only. Copy to .env and fill in the blanks.
# Deployed, BackendStack sets these on the ECS container instead.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/your_guess_who
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# Local dev uses the deployed Cognito pool and S3 bucket.
# UserPoolId and UserPoolClientId outputs:
#   aws cloudformation describe-stacks --region us-east-2 --stack-name AuthStack --query 'Stacks[0].Outputs'
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# your-guess-who-images-<account-id>-us-east-2
S3_BUCKET=

# The AWS SDK clients read this. Without it they use the CLI default region.
AWS_REGION=us-east-2
